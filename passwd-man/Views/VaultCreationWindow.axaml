<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="400"
        x:Class="passwd_man.Views.VaultCreationWindow"
        Width="400"
        Height="600"
        MinWidth="400"
        MinHeight="600"
        MaxWidth="400"
        MaxHeight="600"
        Background="Black"
	Foreground="White"
        Title="Create a vault">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="DarkGray" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Button Hover Styles -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Black" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
    </Window.Styles>



        <StackPanel Margin="5">
            <TextBlock Text="Vault name:" Margin="5"/>
            <TextBox x:Name="VaultName" Watermark="Name"/>
            <TextBlock Text="Path:" Margin="5"/>
            <TextBox x:Name="FolderPathTextBox" Watermark="Path"/>
            <Button Foreground="White" Click="PressedHandler">Choose</Button>
            <TextBlock Text="Password:" Margin="5"/>
            <TextBox x:Name="Password" Watermark="Password" PasswordChar="*"/>
            <TextBlock Text="Confirm password:" Margin="5"/>
            <TextBox x:Name="PasswordCheck" Watermark="Repeat Password" PasswordChar="*"/>
            <TextBlock x:Name="IsOk"/>
            <Button Foreground="White" Click="CreateVault" Margin="5">Create!</Button>
        </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="400"
        x:Class="passwd_man.Views.AddCredentialsWindow"
        Width="400"
        Height="600"
        MinWidth="400"
        MinHeight="600"
        MaxWidth="400"
        MaxHeight="600"
        Background="Black"
        Title="Add Credentials">

        <StackPanel Margin="5">
          <TextBlock Text="Name:" Margin="5"/>
          <TextBox x:Name="CredName" Watermark="Name"/>
          <TextBlock Text="Username:" Margin="5"/>
          <TextBox x:Name="UsernameBox" Watermark="Username"/>
          <TextBlock Text="Password:" Margin="5"/>
          <TextBox x:Name="PasswdBox" Watermark="Password"/>
          <TextBlock Text="Link:" Margin="5"/>
          <TextBox x:Name="Link" Watermark="Link"/>
          <Button Content="Add" Click="AddCredentials" Margin="0,5,0,5"/>
        </StackPanel>
</Window>

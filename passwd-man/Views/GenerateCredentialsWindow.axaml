<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="400"
        x:Class="passwd_man.Views.GenerateCredentialsWindow"
        Title="Generate new credentials"
        Width="400"
        Height="600"
        MinWidth="400"
        MinHeight="600"
        MaxWidth="400"
        MaxHeight="600"
        Background="Black">

        <StackPanel>
                <TextBox x:Name="CredName" Watermark="Name"/>
                <TextBox x:Name="UsernameBox" Watermark="Username"/>
                <TextBox x:Name="Password" Watermark="Password"/>
                <Button x:Name="CopyButton" Content="Copy" Click="CopyPassword"/>
                <TextBlock x:Name="CharAmmountText"/>
                <Slider x:Name="CharAmmount" Minimum="8" Maximum="64"/>
                <TextBox x:Name="LinkBox"/>
                <Button x:Name="AddCreds" Content="Add" Click="AddCredsToVault"/>
        </StackPanel>
</Window>

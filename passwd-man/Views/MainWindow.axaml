<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:passwd_man.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="400"
        x:Class="passwd_man.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="400"
        Height="600"
        MinWidth="400"
        MinHeight="600"
        MaxWidth="400"
        MaxHeight="600"
        Background="Black"
        Title="passwd_man">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel>
        <ItemsControl x:Name="items" ItemsSource="{Binding Credentials}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button Margin="5,0" Command="{Binding GetUsername}">
                           <Image Source="/Assets/ic--baseline-person.png" Width="18" Height="18"/> 
                        </Button>
                        <Button  Margin="5,0" Command="{Binding GetPassword}">
                           <Image Source="/Assets/ic--baseline-lock.png" Width="18" Height="18"/> 
                        </Button>
                        <Button Margin="5,0" Command="{Binding GetLink}">
                           <Image Source="/Assets/ic--baseline-insert-link.png" Width="18" Height="18"/> 
                        </Button>
                        <Button Margin="5,0" Command="{Binding EditItem}">
                           <Image Source="/Assets/ic--baseline-edit.png" Width="18" Height="18"/> 
                        </Button>
                         <Button Margin="5,0" Command="{Binding RemoveItem}">
                           <Image Source="/Assets/ic--baseline-delete-forever.png" Width="18" Height="18"/> 
                        </Button>
                    </StackPanel>
                </DataTemplate> 
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Generate" Command="{Binding GenCredentials}"/>
        <Button Content="Add" Command="{Binding AddCredentials}"/>
    </StackPanel>
</Window>



<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:passwd_man.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="passwd_man.Views.OpenVaultWindow"
        x:DataType="vm:OpenVaultViewModel"
        Width="400"
        Height="600"
        MinWidth="400"
        MinHeight="600"
        MaxWidth="400"
        MaxHeight="600"
        Background="Black"
	Foreground="White"
        Title="Open Vault">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="DarkGray" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Button Hover Styles -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Black" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
    </Window.Styles>


       
        <Design.DataContext>
            <vm:OpenVaultViewModel/>
        </Design.DataContext>

        <StackPanel Margin="5">
            <TextBox x:Name="PasswdBox" Watermark="Password" PasswordChar="*" Text="{Binding Password}"/>
            <ItemsControl x:Name="items" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="OPEN" Foreground="White" Command="{Binding OpenVault}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Foreground="White" Content="Create Vault" Click="CreateVault"/>
        </StackPanel>
</Window>
